# Reference only: this module deliberately does not auto-load any .env file.
# Set these two variables explicitly in the process that starts the library UI.
YUXI_LIBRARY_PORT=4184
# A separately deployed Yuxi server, without /api, userinfo, query or fragment.
# Do not put access tokens, passwords or unrelated service addresses here.
YUXI_LIBRARY_UPSTREAM=http://127.0.0.1:5050
